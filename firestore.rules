rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function rolePath() { return /databases/$(database)/documents/user_roles/$(request.auth.uid); }
    function authorized() { return signedIn() && exists(rolePath()); }
    function myRole() { return get(rolePath()).data.role; }
    function isAdmin() { return authorized() && myRole() == 'admin'; }
    function canEdit() { return authorized() && (myRole() == 'admin' || myRole() == 'editor'); }
    function validRole() { return request.resource.data.role in ['admin', 'editor', 'viewer']; }
    function validModel() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 250
        && request.resource.data.reference is string
        && request.resource.data.reference.size() <= 200
        && request.resource.data.pendingReview is bool
        && request.resource.data.updatedBy == request.auth.uid
        && (!request.resource.data.keys().hasAny(['imageData'])
            || (request.resource.data.imageData is string
                && request.resource.data.imageData.size() <= 90000
                && (request.resource.data.imageData == ''
                    || request.resource.data.imageData.matches('data:image/webp;base64,.*')
                    || request.resource.data.imageData.matches('data:image/jpeg;base64,.*')
                    || request.resource.data.imageData.matches('https://.*'))));
    }

    match /user_roles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validRole();
      allow delete: if false;
    }
    match /models/{modelId} {
      allow get, list: if authorized();
      allow create, update: if canEdit() && validModel();
      allow delete: if canEdit();
    }
    // Um registro de OC pode ser consultado em Amostras e acompanhado em Cortes.
    // As fotos podem ser armazenadas como imagem compactada ou URL pública do catálogo.
    function validProduction() {
      return request.resource.data.keys().hasOnly([
          'oc','name','reference','tailor','imageData','status',
          'createdAt','createdBy','updatedAt','updatedBy','completedAt','completedBy'
        ])
        && request.resource.data.keys().hasAll([
          'oc','name','reference','tailor','imageData','status',
          'createdAt','createdBy','updatedAt','updatedBy','completedAt','completedBy'
        ])
        && request.resource.data.oc is string
        && request.resource.data.oc.size() > 0
        && request.resource.data.oc.size() <= 80
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 250
        && request.resource.data.reference is string
        && request.resource.data.reference.size() <= 200
        && request.resource.data.tailor is string
        && request.resource.data.tailor.size() > 0
        && request.resource.data.tailor.size() <= 120
        && request.resource.data.imageData is string
        && request.resource.data.imageData.size() >= 0
        && request.resource.data.imageData.size() <= 200000
        && (request.resource.data.imageData == ''
            || request.resource.data.imageData.matches('data:image/webp;base64,.*')
            || request.resource.data.imageData.matches('data:image/jpeg;base64,.*')
            || request.resource.data.imageData.matches('https://.*'))
        && request.resource.data.status in ['in_progress', 'done', 'store']
        && request.resource.data.updatedBy == request.auth.uid;
    }
    match /production_samples/{sampleId} {
      allow get, list: if authorized();
      allow create: if canEdit() && validProduction()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'in_progress';
      allow update: if canEdit() && validProduction()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if canEdit();
    }
    match /audit_log/{entryId} {
      allow get, list: if isAdmin();
      allow create: if canEdit()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.action is string
        && request.resource.data.modelName is string;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
