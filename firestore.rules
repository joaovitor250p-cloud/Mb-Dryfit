// MB REFERENCIAS - regras unificadas para fotos e cortes - revisao 28/10/2026
// NAO modifica regras antigas de usuarios, pagamentos ou dispositivos.
// ATENCAO: /usuarios/{whatsapp} possui allow get: if true (risco existente).
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // REGRAS LEGADAS enviadas pelo proprietario (mantidas sem alteracoes)
    // ---------------------------------------------------------------------
    function logado() {
      return request.auth != null;
    }

    function donoAtual() {
      return logado()
        && resource.data.authUid == request.auth.uid;
    }

    function donoNovo() {
      return logado()
        && request.resource.data.authUid == request.auth.uid;
    }

    function whatsappCorreto(whatsapp) {
      return request.resource.data.whatsapp == whatsapp;
    }

    function alteracaoSomenteSessao() {
      return donoAtual()
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.whatsapp == resource.data.whatsapp
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'deviceId',
            'ultimoLoginEm',
            'atualizadoEm'
          ]);
    }

    function removerSenhaLegada() {
      return donoAtual()
        && ('senha' in resource.data)
        && !('senha' in request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['senha']);
    }

    function ativacaoTesteValida() {
      return donoAtual()
        && resource.data.jaUsouTeste == false
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.whatsapp == resource.data.whatsapp

        && request.resource.data.jaUsouTeste == true
        && request.resource.data.ativo == true
        && request.resource.data.bloqueado == false
        && request.resource.data.tipo == 'teste'
        && request.resource.data.plano == 'Teste Grátis (10 Dias)'
        && request.resource.data.duracaoDias == 10

        && request.resource.data.ativadoEm is int
        && request.resource.data.expiraEm is int

        && timestamp.value(request.resource.data.ativadoEm)
          >= request.time - duration.value(5, 'm')

        && timestamp.value(request.resource.data.ativadoEm)
          <= request.time + duration.value(1, 'm')

        && timestamp.value(request.resource.data.expiraEm)
          == timestamp.value(request.resource.data.ativadoEm)
             + duration.value(10, 'd')

        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'email',
            'expiraEm',
            'ativo',
            'bloqueado',
            'deviceId',
            'jaUsouTeste',
            'tipo',
            'plano',
            'duracaoDias',
            'indicadoPor',
            'ativadoEm',
            'atualizadoEm'
          ]);
    }

    match /usuarios/{whatsapp} {
      /*
       * COMPATIBILIDADE LEGADA: o login atual busca o documento
       * pelo WhatsApp ANTES da autenticação. NÃO É SEGURO:
       * libera TODOS os campos do documento a quem conhecer o número.
       * Migrar a descoberta do e-mail para endpoint seguro no Worker
       * e depois trocar por: allow get: if donoAtual();
       * Não fechar enquanto o app oficial ainda depender disso.
       */
      allow get: if true;

      /*
       * CORREÇÃO DE RECUPERAÇÃO DE SESSÃO:
       * js/app.js faz where('authUid', '==', user.uid).limit(2)
       * quando perdeu o vínculo local do WhatsApp.
       * Permitir APENAS consulta autenticada restrita ao próprio UID.
       * Regras não filtram: consulta sem where compatível será negada.
       */
      allow list: if logado()
        && request.query.limit <= 2
        && resource.data.authUid == request.auth.uid;

      allow create: if donoNovo()
        && whatsappCorreto(whatsapp)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.ativo == false
        && request.resource.data.bloqueado == false
        && request.resource.data.jaUsouTeste == false
        && request.resource.data.tipo == 'cadastro'
        && request.resource.data.plano == 'Sem assinatura'
        && request.resource.data.keys().hasOnly([
          'whatsapp',
          'email',
          'authUid',
          'deviceId',
          'atualizadoEm',
          'ativo',
          'bloqueado',
          'jaUsouTeste',
          'tipo',
          'plano',
          'criadoEm'
        ]);

      allow update: if
        alteracaoSomenteSessao()
        || removerSenhaLegada()
        || ativacaoTesteValida();

      allow delete: if false;
    }

    match /dispositivos_bloqueados/{deviceId} {
      allow get: if logado();
      allow list: if false;

      allow create: if logado()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.whatsapp is string
        && request.resource.data.bloqueadoEm is int

        && exists(
          /databases/$(database)/documents/usuarios/$(request.resource.data.whatsapp)
        )

        && get(
          /databases/$(database)/documents/usuarios/$(request.resource.data.whatsapp)
        ).data.authUid == request.auth.uid

        && get(
          /databases/$(database)/documents/usuarios/$(request.resource.data.whatsapp)
        ).data.jaUsouTeste == true

        && timestamp.value(request.resource.data.bloqueadoEm)
          >= request.time - duration.value(5, 'm')

        && timestamp.value(request.resource.data.bloqueadoEm)
          <= request.time + duration.value(1, 'm')

        && request.resource.data.keys().hasOnly([
          'whatsapp',
          'authUid',
          'bloqueadoEm'
        ]);

      allow update, delete: if false;
    }

    match /pagamentos_concluidos/{pagamentoId} {
      allow read, write: if false;
    }

    match /sistema_config/{docId} {
      allow read: if docId == 'broadcast';
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // MB REFERENCIAS: login, catalogo, fotos, cortes e auditoria.
    // Exige usuario autenticado com perfil em user_roles.
    // ---------------------------------------------------------------------
    function signedIn() { return request.auth != null; }
    function rolePath() { return /databases/$(database)/documents/user_roles/$(request.auth.uid); }
    function authorized() { return signedIn() && exists(rolePath()) && get(rolePath()).data.get('disabled', false) != true; }
    function myRole() { return get(rolePath()).data.role; }
    function isAdmin() { return authorized() && myRole() == 'admin'; }
    function canEdit() { return authorized() && (myRole() == 'admin' || myRole() == 'editor'); }
    function canView(area) { return authorized() && (isAdmin() || !('permissions' in get(rolePath()).data) || area in get(rolePath()).data.permissions); }
    function canWrite(area) { return canEdit() && canView(area); }
    function validRole() { return request.resource.data.role in ['admin', 'editor', 'viewer']; }

    // Aceita fotos locais reduzidas e enderecos HTTPS do catalogo.
    // Nao permite javascript:, http: ou outros esquemas.
    function validPhotoValue(value) {
      return value is string
        && value.size() <= 90000
        && (value == ''
          || value.matches('https://.+')
          || value.matches('data:image/webp;base64,.*')
          || value.matches('data:image/jpeg;base64,.*'));
    }

    function validModel() {
      let data = request.resource.data;
      return data.name is string
        && data.name.size() > 0 && data.name.size() <= 250
        && data.reference is string && data.reference.size() <= 200
        // Alguns modelos anteriores ao modulo de fotos nao tem pendingReview.
        && data.get('pendingReview', false) is bool
        && data.updatedBy == request.auth.uid
        && data.get('imageData', '') is string
        && validPhotoValue(data.get('imageData', ''));
    }

    function validPhotoOnlyUpdate() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      return diff.hasOnly(['imageData', 'updatedAt', 'updatedBy'])
        && diff.hasAny(['imageData'])
        && request.resource.data.updatedBy == request.auth.uid
        // serverTimestamp() aparece nas regras como request.time.
        && request.resource.data.updatedAt == request.time
        && validPhotoValue(request.resource.data.imageData);
    }

    // Cadastro gratuito: a conta Firebase Auth existe, porém não recebe
    // acesso aos dados sem um user_roles aprovado pelo administrador.
    function validSections(sections) {
      return sections is list
        && sections.size() >= 1 && sections.size() <= 3
        && sections.hasOnly(['catalog', 'samples', 'cuts']);
    }
    function validGrant() {
      let data = request.resource.data;
      return data.keys().hasOnly(['email','role','permissions','disabled','approvedAt','approvedBy'])
        && data.keys().hasAll(['email','role','permissions','disabled','approvedAt','approvedBy'])
        && data.email is string && data.email.size() <= 320
        && data.role in ['viewer', 'editor']
        && validSections(data.permissions)
        && data.disabled == false
        && data.approvedBy == request.auth.uid
        && data.approvedAt == request.time;
    }
    function validRoleUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['role','permissions','disabled','updatedAt','updatedBy'])
        && request.resource.data.role in ['viewer', 'editor']
        && validSections(request.resource.data.permissions)
        && request.resource.data.get('disabled', false) is bool
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }
    match /access_requests/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && uid == request.auth.uid
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['email','status','requestedAt'])
        && request.resource.data.keys().hasAll(['email','status','requestedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time;
      // Uma solicitação recusada pode ser refeita. Não pode autoaprovar-se.
      allow update: if (
        signedIn() && uid == request.auth.uid
        && request.auth.token.email_verified == true
        && resource.data.status == 'denied'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','requestedAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time
      ) || (
        isAdmin() && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy'])
        && request.resource.data.status in ['approved','denied']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
      );
      allow delete: if false;
    }
    match /user_roles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // Aprovação concedida pelo admin, nunca pelo próprio solicitante.
      allow create: if isAdmin() && uid != request.auth.uid
        && exists(/databases/$(database)/documents/access_requests/$(uid))
        && get(/databases/$(database)/documents/access_requests/$(uid)).data.status == 'pending'
        && request.resource.data.email == get(/databases/$(database)/documents/access_requests/$(uid)).data.email
        && validGrant();
      allow update: if isAdmin() && uid != request.auth.uid
        && resource.data.role != 'admin' && validRoleUpdate();
      // Não excluir permissões acidentalmente: usar disabled=true.
      allow delete: if false;
    }

    match /models/{modelId} {
      // Modelos sao compartilhados com as telas Amostras e Cortes.
      allow get, list: if canView('catalog') || canView('samples') || canView('cuts');
      allow create: if canWrite('catalog') && validModel();
      // Testa primeiro a alteracao pontual: documentos antigos nao
      // precisam ter todos os campos dos cadastros novos.
      allow update: if canWrite('catalog') && (validPhotoOnlyUpdate() || validModel());
      allow delete: if canWrite('catalog');
    }

    function validProduction() {
      return request.resource.data.keys().hasOnly([
          'oc','name','reference','tailor','imageData','status',
          'createdAt','createdBy','updatedAt','updatedBy','completedAt','completedBy'
        ])
        && request.resource.data.keys().hasAll([
          'oc','name','reference','tailor','imageData','status',
          'createdAt','createdBy','updatedAt','updatedBy','completedAt','completedBy'
        ])
        && request.resource.data.oc is string
        && request.resource.data.oc.size() > 0
        && request.resource.data.oc.size() <= 80
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 250
        && request.resource.data.reference is string
        && request.resource.data.reference.size() <= 200
        && request.resource.data.tailor is string
        && request.resource.data.tailor.size() > 0
        && request.resource.data.tailor.size() <= 120
        && request.resource.data.imageData is string
        && request.resource.data.imageData.size() <= 200000
        && (request.resource.data.imageData == ''
            || request.resource.data.imageData.matches('data:image/webp;base64,.*')
            || request.resource.data.imageData.matches('data:image/jpeg;base64,.*')
            || request.resource.data.imageData.matches('https://.*'))
        && request.resource.data.status in ['in_progress', 'done', 'store']
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validStatusOnlyUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let next = request.resource.data;
      return changed.hasOnly(['status', 'completedAt', 'completedBy', 'updatedAt', 'updatedBy'])
        && changed.hasAny(['status'])
        && next.status in ['in_progress', 'done', 'store']
        && (
          (resource.data.status == 'in_progress' && next.status == 'done')
          || (resource.data.status == 'done' && next.status == 'store')
          || (resource.data.status in ['done', 'store'] && next.status == 'in_progress')
        )
        && next.updatedBy == request.auth.uid
        && next.updatedAt == request.time
        // Campos antigos podem estar ausentes ou em formatos legados.
        // Validar o tipo apenas quando a transicao alterar esses campos.
        && (!changed.hasAny(['completedAt'])
          || next.get('completedAt', null) == null
          || next.get('completedAt', null) is timestamp)
        && (!changed.hasAny(['completedBy'])
          || next.get('completedBy', null) == null
          || next.get('completedBy', null) is string);
    }

    match /production_samples/{sampleId} {
      allow get, list: if canView('samples') || canView('cuts');
      allow create: if canWrite('samples') && validProduction()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'in_progress';
      allow update: if canEdit() && (
          (canView('cuts') && validStatusOnlyUpdate())
          || (canView('samples') && validProduction()
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt)
        );
      allow delete: if canWrite('samples');
    }

    match /audit_log/{entryId} {
      allow get, list: if isAdmin();
      allow create: if canEdit()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.action is string
        && request.resource.data.modelName is string;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
