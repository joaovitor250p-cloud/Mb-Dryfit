rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function rolePath() {
      return /databases/$(database)/documents/user_roles/$(request.auth.uid);
    }

    function authorized() {
      return signedIn()
        && exists(rolePath())
        && get(rolePath()).data.get('disabled', false) != true;
    }

    function myRole() {
      return get(rolePath()).data.role;
    }

    function isAdmin() {
      return authorized() && myRole() == 'admin';
    }

    function canEdit() {
      return authorized()
        && (myRole() == 'admin' || myRole() == 'editor');
    }

    function canView(area) {
      return authorized()
        && (
          isAdmin()
          || (
            'permissions' in get(rolePath()).data
            && get(rolePath()).data.permissions is list
            && area in get(rolePath()).data.permissions
          )
          || (
            !('permissions' in get(rolePath()).data)
            && area in ['catalog', 'samples', 'cuts', 'orders']
          )
        );
    }

    function canWrite(area) {
      return canEdit() && canView(area);
    }

    function validSections(sections) {
      return sections is list
        && sections.size() >= 1
        && sections.size() <= 11
        && sections.hasOnly([
          'catalog', 'samples', 'cuts', 'orders', 'expenses', 'info', 'workshops', 'sheets', 'sheet_distribution', 'enfesto', 'purchases'
        ]);
    }

    function validGrant() {
      let data = request.resource.data;

      return data.keys().hasOnly([
          'email',
          'role',
          'permissions',
          'disabled',
          'approvedAt',
          'approvedBy',
          'companyId'
        ])
        && data.keys().hasAll([
          'email',
          'role',
          'permissions',
          'disabled',
          'approvedAt',
          'approvedBy'
        ])
        && data.email is string
        && data.email.size() <= 320
        && data.role in ['viewer', 'editor']
        && data.get('companyId','mb-principal') == currentCompany()
        && validSections(data.permissions)
        && data.disabled == false
        && data.approvedBy == request.auth.uid
        && data.approvedAt == request.time;
    }

    function validRoleUpdate() {
      let next = request.resource.data;
      let changed = next.diff(resource.data).affectedKeys();

      return changed.hasOnly([
          'role',
          'permissions',
          'disabled',
          'updatedAt',
          'updatedBy'
        ])
        && next.role in ['viewer', 'editor']
        && validSections(
          next.get('permissions', ['catalog', 'samples', 'cuts', 'orders'])
        )
        && next.get('disabled', false) is bool
        && next.updatedBy == request.auth.uid
        && next.updatedAt == request.time;
    }

    match /access_requests/{uid} {

      allow get: if signedIn()
        && (request.auth.uid == uid || isAdmin());

      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly([
          'email', 'status', 'requestedAt'
        ])
        && request.resource.data.keys().hasAll([
          'email', 'status', 'requestedAt'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time;

      allow update: if (

        signedIn()
        && uid == request.auth.uid
        && request.auth.token.email_verified == true
        && resource.data.email == request.auth.token.email
        && resource.data.status == 'denied'
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['status', 'requestedAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time

      ) || (

        isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['approved', 'denied']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
      );

      allow delete: if false;
    }

    match /user_roles/{uid} {

      allow get: if signedIn()
        && (request.auth.uid == uid || isAdmin());

      allow list: if isAdmin();

      allow create: if isAdmin()
        && uid != request.auth.uid
        && exists(
          /databases/$(database)/documents/access_requests/$(uid)
        )
        && get(
          /databases/$(database)/documents/access_requests/$(uid)
        ).data.status == 'pending'
        && request.resource.data.email == get(
          /databases/$(database)/documents/access_requests/$(uid)
        ).data.email
        && validGrant();

      allow update: if isAdmin()
        && uid != request.auth.uid
        && resource.data.role != 'admin'
        && validRoleUpdate();

      allow delete: if false;
    }

    function validPhotoValue(value) {
      return value is string
        && value.size() <= 90000
        && (
          value == ''
          || value.matches('https://.+')
          || value.matches('data:image/webp;base64,.*')
          || value.matches('data:image/jpeg;base64,.*')
        );
    }

    function validModel() {
      let data = request.resource.data;

      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 250
        && data.reference is string
        && data.reference.size() <= 200
        && data.get('pendingReview', false) is bool
        && data.updatedBy == request.auth.uid
        && validPhotoValue(data.get('imageData', ''));
    }

    function validPhotoOnlyUpdate() {
      let changed = request.resource.data.diff(resource.data)
        .affectedKeys();

      return changed.hasOnly([
          'imageData', 'updatedAt', 'updatedBy'
        ])
        && changed.hasAny(['imageData'])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && validPhotoValue(request.resource.data.imageData);
    }

    match /models/{modelId} {

      allow get, list: if canView('catalog')
        || canView('samples')
        || canView('cuts');

      allow create: if canWrite('catalog')
        && validModel();

      allow update: if canWrite('catalog')
        && (
          validPhotoOnlyUpdate()
          || validModel()
        );

      allow delete: if canWrite('catalog');
    }

    function validProductionPhoto(value) {
      return value is string
        && value.size() <= 200000
        && (
          value == ''
          || value.matches('data:image/webp;base64,.*')
          || value.matches('data:image/jpeg;base64,.*')
          || value.matches('https://.+')
        );
    }

    function validProductionExtraImages(data) {
      let photos = data.get('extraImages', []);
      return photos is list
        && photos.size() <= 2
        && (photos.size() < 1 || (
          photos[0] is string
          && photos[0].size() > 0
          && validProductionPhoto(photos[0])
        ))
        && (photos.size() < 2 || (
          photos[1] is string
          && photos[1].size() > 0
          && validProductionPhoto(photos[1])
        ));
    }

    function validProduction() {
      let data = request.resource.data;

      return data.keys().hasOnly([
          'oc',
          'name',
          'reference',
          'tailor',
          'quantity',
          'orderId',
          'imageData',
          'extraImages',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy',
          'completedAt',
          'completedBy'
        ])
        && data.keys().hasAll([
          'oc',
          'name',
          'reference',
          'tailor',
          'imageData',
          'status',
          'updatedAt',
          'updatedBy'
        ])
        && data.oc is string
        && data.oc.size() > 0
        && data.oc.size() <= 80
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 250
        && data.reference is string
        && data.reference.size() <= 200
        && data.tailor is string
        && data.tailor.size() > 0
        && data.tailor.size() <= 120
        && (!('quantity' in data) || (data.quantity is string && data.quantity.size() <= 12 && data.quantity.matches('^[0-9]*$')))
        && (!('orderId' in data) || (data.orderId is string && data.orderId.size() > 0 && data.orderId.size() <= 200))
        && validProductionPhoto(data.imageData)
        && validProductionExtraImages(data)
        && data.status in ['in_progress', 'done', 'store']
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time
        && (!('createdAt' in data) || data.createdAt == null || data.createdAt is timestamp)
        && (!('createdBy' in data) || data.createdBy is string)
        && (!('completedAt' in data) || data.completedAt == null || data.completedAt is timestamp)
        && (!('completedBy' in data) || data.completedBy == null || data.completedBy is string);
    }

    function validStatusOnlyUpdate() {
      let changed = request.resource.data.diff(resource.data)
        .affectedKeys();

      let next = request.resource.data;

      return changed.hasOnly([
          'status',
          'completedAt',
          'completedBy',
          'updatedAt',
          'updatedBy'
        ])
        && changed.hasAny(['status'])
        && next.status in ['in_progress', 'done']
        && (
          (
            resource.data.status == 'in_progress'
            && next.status == 'done'
          )
          || (
            resource.data.status in ['done', 'store']
            && next.status == 'in_progress'
          )
        )
        && next.updatedBy == request.auth.uid
        && next.updatedAt == request.time
        && (
          !changed.hasAny(['completedAt'])
          || next.get('completedAt', null) == null
          || next.get('completedAt', null) is timestamp
        )
        && (
          !changed.hasAny(['completedBy'])
          || next.get('completedBy', null) == null
          || next.get('completedBy', null) is string
        );
    }

    // Entrega de uma OC cria ou complementa a amostra na mesma transação.
    // A operação só pode apontar para uma OC realmente ENTREGUE e gravada pelo usuário.
    function deliveredOrderForSample(data) {
      return ('orderId' in data)
        && data.orderId is string
        && data.orderId.size() > 0
        && data.orderId.size() <= 200
        && existsAfter(/databases/$(database)/documents/cut_orders/$(data.orderId))
        && getAfter(/databases/$(database)/documents/cut_orders/$(data.orderId)).data.status == 'ENTREGUE'
        && getAfter(/databases/$(database)/documents/cut_orders/$(data.orderId)).data.updatedBy == request.auth.uid
        && data.quantity == getAfter(/databases/$(database)/documents/cut_orders/$(data.orderId)).data.qty;
    }

    function newSampleMatchesOrder(data) {
      let order = getAfter(/databases/$(database)/documents/cut_orders/$(data.orderId)).data;
      return data.oc == order.oc
        && data.name == order.model
        && data.reference == order.ref
        && (data.tailor == order.office || (order.office == '' && data.tailor == 'NÃO INFORMADO'));
    }

    match /production_samples/{sampleId} {

      allow get, list: if canView('samples')
        || canView('cuts')
        || canView('orders');

      allow create: if (
        canWrite('samples')
        && validProduction()
        && !('extraImages' in request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'in_progress'
      ) || (
        canWrite('orders')
        && validProduction()
        && !('extraImages' in request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'done'
        && request.resource.data.imageData == ''
        && deliveredOrderForSample(request.resource.data)
        && newSampleMatchesOrder(request.resource.data)
      );

      allow update: if (

        canWrite('cuts')
        && validStatusOnlyUpdate()

      ) || (

        canWrite('samples')
        && validProduction()
        && (!('extraImages' in request.resource.data) || ('extraImages' in resource.data))
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.status == resource.data.status
      ) || (
        canWrite('orders')
        && validProduction()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'quantity', 'orderId', 'reference', 'tailor', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
        && deliveredOrderForSample(request.resource.data)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reference'])
          || (resource.data.reference == ''
            && request.resource.data.reference == getAfter(/databases/$(database)/documents/cut_orders/$(request.resource.data.orderId)).data.ref)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tailor'])
          || (resource.data.tailor == 'NÃO INFORMADO'
            && request.resource.data.tailor == getAfter(/databases/$(database)/documents/cut_orders/$(request.resource.data.orderId)).data.office)
        )
      );

      allow delete: if canWrite('samples');

      match /gallery/{photoId} {
        allow get: if photoId in ['photo_2', 'photo_3'] && canView('samples');
        allow list: if false;

        allow create, update: if photoId in ['photo_2', 'photo_3']
          && canWrite('samples')
          && exists(/databases/$(database)/documents/production_samples/$(sampleId))
          && request.resource.data.keys().hasOnly(['imageData', 'updatedAt', 'updatedBy'])
          && request.resource.data.keys().hasAll(['imageData', 'updatedAt', 'updatedBy'])
          && request.resource.data.imageData is string
          && request.resource.data.imageData.size() > 0
          && request.resource.data.imageData.size() <= 200000
          && (
            request.resource.data.imageData.matches('data:image/webp;base64,.*')
            || request.resource.data.imageData.matches('data:image/jpeg;base64,.*')
          )
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        allow delete: if photoId in ['photo_2', 'photo_3'] && canWrite('samples');
      }

      match /photos/{photoId} {
        allow get, list, create, update: if false;
        allow delete: if canWrite('samples') && photoId in ['photo_1', 'photo_2'];
      }
    }

    function validCutOrder() {
      let d = request.resource.data;

      return d.keys().hasOnly([
          'oc','ref','model','office','qty','piecePrice','pieceType',
          'entry','sent','due','status','deliveredFlag',
          'deliveredAt','defects','discountPiece',
          'discountTotal','total','paidAt','paymentDone',
          'manualTotal','source',
          'createdAt','createdBy','updatedAt','updatedBy'
        ])
        && d.keys().hasAll([
          'oc','ref','model','office','qty','piecePrice',
          'entry','sent','due','status','deliveredFlag',
          'deliveredAt','defects','discountPiece',
          'discountTotal','total','paidAt','paymentDone',
          'manualTotal','source',
          'createdAt','createdBy','updatedAt','updatedBy'
        ])
        && (!('pieceType' in d) || (d.pieceType is string && d.pieceType.size() <= 80))

        && d.oc is string
        && d.oc.size() > 0
        && d.oc.size() <= 80

        && d.model is string
        && d.model.size() > 0
        && d.model.size() <= 250

        && d.ref is string
        && d.ref.size() <= 100

        && d.office is string
        && d.office.size() <= 120

        && d.qty is string
        && d.qty.size() <= 30

        && d.piecePrice is string
        && d.piecePrice.size() <= 80

        && d.entry is string
        && d.entry.size() <= 30

        && d.sent is string
        && d.sent.size() <= 30

        && d.due is string
        && d.due.size() <= 30

        && d.deliveredFlag is string
        && d.deliveredFlag.size() <= 30

        && d.deliveredAt is string
        && d.deliveredAt.size() <= 30

        && d.defects is string
        && d.defects.size() <= 30

        && d.discountPiece is string
        && d.discountPiece.size() <= 80

        && d.discountTotal is string
        && d.discountTotal.size() <= 80

        && d.total is string
        && d.total.size() <= 80

        && d.paidAt is string
        && d.paidAt.size() <= 30

        && d.paymentDone in ['OK', '']

        && d.status in ['ENTREGUE', 'EM ANDAMENTO']

        && d.manualTotal is bool

        && d.source in ['manual', 'planilha_original']

        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time

        && d.createdBy is string;
    }

    match /cut_orders/{orderId} {

      allow get, list: if canView('orders');

      allow create: if (canWrite('orders') || (canWrite('sheet_distribution')
          && existsAfter(/databases/$(database)/documents/production_sheets/$(orderId))
          && getAfter(/databases/$(database)/documents/production_sheets/$(orderId)).data.status == 'assigned'
          && getAfter(/databases/$(database)/documents/production_sheets/$(orderId)).data.assignedBy == request.auth.uid
          && get(/databases/$(database)/documents/production_sheets/$(orderId)).data.status == 'pending'
           && get(/databases/$(database)/documents/production_sheets/$(orderId)).data.get('enfestoConfirmationId', '') == orderId
          && request.resource.data.oc == getAfter(/databases/$(database)/documents/production_sheets/$(orderId)).data.oc
          && request.resource.data.ref == getAfter(/databases/$(database)/documents/production_sheets/$(orderId)).data.reference
          && request.resource.data.office == getAfter(/databases/$(database)/documents/production_sheets/$(orderId)).data.assignedTailor))
        && validCutOrder()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if canWrite('orders')
        && validCutOrder()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.source == resource.data.source;

      allow delete: if isAdmin();
    }

    function validExpense() {
      let d = request.resource.data;

      return d.keys().hasOnly([
          'name', 'amount', 'date', 'notes',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && d.keys().hasAll([
          'name', 'amount', 'date', 'notes',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 250
        && d.amount is string
        && d.amount.size() > 0
        && d.amount.size() <= 80
        && d.date is string
        && d.date.size() <= 20
        && d.notes is string
        && d.notes.size() <= 1000
        && d.createdBy is string
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }

    match /expenses/{expenseId} {
      allow get, list: if canView('expenses');

      allow create: if canWrite('expenses')
        && validExpense()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if canWrite('expenses')
        && validExpense()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if canWrite('expenses');

      match /attachments/{attachmentId} {
        allow get: if attachmentId == 'receipt' && canView('expenses');
        allow list: if false;

        allow create, update: if attachmentId == 'receipt'
          && canWrite('expenses')
          && exists(/databases/$(database)/documents/expenses/$(expenseId))
          && request.resource.data.keys().hasOnly(['imageData', 'updatedAt', 'updatedBy'])
          && request.resource.data.keys().hasAll(['imageData', 'updatedAt', 'updatedBy'])
          && request.resource.data.imageData is string
          && request.resource.data.imageData.size() > 0
          && request.resource.data.imageData.size() <= 160000
          && (
            request.resource.data.imageData.matches('data:image/webp;base64,.*')
            || request.resource.data.imageData.matches('data:image/jpeg;base64,.*')
          )
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        allow delete: if attachmentId == 'receipt' && canWrite('expenses');
      }
    }

    function validMbInfo() {
      let d = request.resource.data;

      return d.keys().hasOnly([
          'name', 'value', 'pix', 'pixName', 'notes',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && d.keys().hasAll([
          'name', 'value', 'pix', 'pixName', 'notes',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 250
        && d.value is string
        && d.value.size() <= 120
        && d.pix is string
        && d.pix.size() <= 200
        && d.pixName is string
        && d.pixName.size() <= 250
        && d.notes is string
        && d.notes.size() <= 1000
        && d.createdBy is string
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }

    match /mb_info/{infoId} {
      allow get, list: if canView('info');

      allow create: if canWrite('info')
        && validMbInfo()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if canWrite('info')
        && validMbInfo()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if canWrite('info');
    }

    function validWorkshop() {
      let d = request.resource.data;

      return d.keys().hasOnly([
          'name', 'phone', 'pix', 'address', 'types', 'specialPrices', 'services', 'notes',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && d.keys().hasAll([
          'name', 'phone', 'pix', 'types', 'specialPrices', 'services', 'notes',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 250
        && d.phone is string
        && d.phone.size() <= 60
        && d.pix is string && d.pix.size() <= 250
        && (!('address' in d) || (d.address is string && d.address.size() <= 800))
        && d.types is list && d.types.size() <= 20
        && d.specialPrices is list && d.specialPrices.size() <= 150
        && d.services is list
        && d.services.size() <= 50
        && d.notes is string
        && d.notes.size() <= 1000
        && d.createdBy is string
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }

    match /workshops/{workshopId} {
      allow get, list: if canView('workshops') || canView('sheet_distribution') || canWrite('orders');

      allow create: if canWrite('workshops')
        && validWorkshop()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if canWrite('workshops')
        && validWorkshop()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if canWrite('workshops');
    }

    match /reference_prices/{priceId} {
      allow get, list: if canView('workshops') || canView('sheet_distribution') || canView('orders');
      // Quem pode editar OCs pode CADASTRAR uma nova REF sem sair do formulário.
      // Apenas administradores de Oficinas/Preços podem ALTERAR preços já cadastrados.
      allow create: if (canWrite('workshops') || canWrite('orders'))
        && request.resource.data.keys().hasOnly(['reference','type','price','updatedAt','updatedBy'])
        && request.resource.data.reference is string && request.resource.data.reference.size() > 0 && request.resource.data.reference.size() <= 80
        && request.resource.data.type is string && request.resource.data.type.size() > 0 && request.resource.data.type.size() <= 80
        && request.resource.data.price is string && request.resource.data.price.size() <= 30
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow update: if canWrite('workshops')
        && request.resource.data.keys().hasOnly(['reference','type','price','updatedAt','updatedBy'])
        && request.resource.data.reference is string && request.resource.data.reference.size() > 0 && request.resource.data.reference.size() <= 80
        && request.resource.data.type is string && request.resource.data.type.size() > 0 && request.resource.data.type.size() <= 80
        && request.resource.data.price is string && request.resource.data.price.size() <= 30
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /audit_log/{entryId} {

      allow get, list: if isAdmin();

      allow create: if canEdit()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.action is string
        && request.resource.data.modelName is string;

      allow update, delete: if false;
    }

    // Fichas de produção: a atribuição é exclusiva de editores autorizados
    // individualmente pelo administrador para sheet_distribution.
    function validSheetFields(d) {
      return d.keys().hasOnly(['model','reference','pieceType','fabric','volumes','composition','trims','officeInstructions','oc','withdrawalDate','tailorInstructions','finishingInstructions','colors','status','assignedTailor','createdAt','createdBy','updatedAt','updatedBy','assignedAt','assignedBy','enfestoCompletedAt','enfestoCompletedBy','enfestoConfirmationId'])
        && d.keys().hasAll(['model','reference','composition','trims','officeInstructions','oc','withdrawalDate','tailorInstructions','finishingInstructions','colors','status','assignedTailor','createdAt','createdBy','updatedAt','updatedBy','assignedAt','assignedBy'])
        && d.model is string && (d.status == 'draft' || d.model.size() > 0) && d.model.size() <= 250
        && d.reference is string && (d.status == 'draft' || d.reference.size() > 0) && d.reference.size() <= 200
        && (!('pieceType' in d) || (d.pieceType is string && d.pieceType.size() <= 80))
        && (!('volumes' in d) || (d.volumes is string && d.volumes.matches('^[0-9]{0,6}$')))
        && (!('fabric' in d) || (d.fabric is string && d.fabric.size() <= 250))
        && d.composition is string && d.composition.size() <= 2000
        && d.trims is string && d.trims.size() <= 4000
        && d.officeInstructions is string && d.officeInstructions.size() <= 4000
        && d.oc is string && (d.status == 'draft' || d.oc.size() > 0) && d.oc.size() <= 80
        && d.withdrawalDate is string && d.withdrawalDate.size() <= 30
        && d.tailorInstructions is string && d.tailorInstructions.size() <= 4000
        && d.finishingInstructions is string && d.finishingInstructions.size() <= 4000
        && d.colors is list && d.colors.size() <= 50
        && d.status in ['draft','enfesto','pending','assigned']
        && d.assignedTailor is string && d.assignedTailor.size() <= 120
        && d.createdBy is string && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time
        && (d.assignedAt == null || d.assignedAt is timestamp)
        && (d.assignedBy == null || d.assignedBy is string)
        && (!('enfestoCompletedAt' in d) || d.enfestoCompletedAt is timestamp)
        && (!('enfestoCompletedBy' in d) || (d.enfestoCompletedBy is string && d.enfestoCompletedBy.size() <= 120))
        && (!('enfestoConfirmationId' in d) || (d.enfestoConfirmationId is string && d.enfestoConfirmationId.size() <= 100));
    }

    match /production_sheets/{sheetId} {
      // Quem acessa Ordens de Corte pode baixar somente fichas já distribuídas,
      // pelo ID específico da OC; não libera listagem de fichas nem rascunhos.
      allow get: if canView('sheets') || canView('enfesto') || canView('sheet_distribution')
        || (canView('orders') && resource.data.status == 'assigned');
      allow list: if canView('sheets') || canView('enfesto') || canView('sheet_distribution');
      allow create: if canWrite('sheets') && validSheetFields(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.status in ['draft','enfesto']
        && request.resource.data.assignedTailor == ''
        && request.resource.data.assignedAt == null
        && request.resource.data.assignedBy == null;
      allow update: if (
        canWrite('sheets') && validSheetFields(request.resource.data)
        && resource.data.status == 'draft'
        && request.resource.data.status in ['draft','enfesto']
        && request.auth.uid == resource.data.createdBy
        && request.resource.data.assignedTailor == ''
        && request.resource.data.assignedAt == null
        && request.resource.data.assignedBy == null
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
      ) || (
        // Concluir o enfesto somente com a baixa do estoque na mesma transação.
        canWrite('enfesto') && validSheetFields(request.resource.data)
        && resource.data.status in ['enfesto','pending']
        && resource.data.get('enfestoConfirmationId', '') == ''
        && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status','enfestoCompletedAt','enfestoCompletedBy','enfestoConfirmationId','updatedAt','updatedBy'])
        && request.resource.data.enfestoCompletedAt == request.time
        && request.resource.data.enfestoCompletedBy == request.auth.uid
        && request.resource.data.enfestoConfirmationId == sheetId
        && existsAfter(/databases/$(database)/documents/companies/$(currentCompany())/enfesto_confirmations/$(sheetId))
        && getAfter(/databases/$(database)/documents/companies/$(currentCompany())/enfesto_confirmations/$(sheetId)).data.status == 'confirmed'
        && getAfter(/databases/$(database)/documents/companies/$(currentCompany())/enfesto_confirmations/$(sheetId)).data.sheetId == sheetId
        && getAfter(/databases/$(database)/documents/companies/$(currentCompany())/enfesto_confirmations/$(sheetId)).data.createdBy == request.auth.uid
      ) || (
        canWrite('sheet_distribution') && validSheetFields(request.resource.data)
        && resource.data.status == 'pending'
        && resource.data.get('enfestoConfirmationId', '') == sheetId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','assignedTailor','assignedAt','assignedBy','updatedAt','updatedBy'])
        && request.resource.data.status == 'assigned'
        && request.resource.data.assignedTailor.size() > 0
        && request.resource.data.assignedAt == request.time
        && request.resource.data.assignedBy == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    function currentCompany() {
      // Projetos legados MB já existentes pertencem à empresa principal.
      // IDs diferentes têm isolamento real por user_roles.companyId.
      return get(rolePath()).data.get('companyId', 'mb-principal');
    }
    function canCompanyView(companyId) {
      return canView('purchases') && currentCompany() == companyId;
    }
    function canCompanyBuy(companyId) {
      return canWrite('purchases') && currentCompany() == companyId;
    }
    function canCompanyConsume(companyId) {
      return (canWrite('purchases') || canWrite('cuts') || canWrite('enfesto')) && currentCompany() == companyId;
    }
    function validStock(d) {
      return d.keys().hasOnly(['material','color','kind','unit','quantityMilli','lastMovementId','lastDeltaMilli','updatedAt','updatedBy','createdAt'])
        && d.keys().hasAll(['material','color','kind','unit','quantityMilli','lastMovementId','lastDeltaMilli','updatedAt','updatedBy','createdAt'])
        && d.material is string && d.material.size() > 0 && d.material.size() <= 250
        && d.color is string && d.color.size() > 0 && d.color.size() <= 100
        && d.kind in ['tecido', 'material'] && d.unit in ['KG','M','UN','PC','CX','L','OUT']
        && (d.kind != 'tecido' || d.unit in ['KG','M'])
        && d.quantityMilli is int && d.quantityMilli >= 0 && d.quantityMilli <= 1000000000000
        && d.lastDeltaMilli is int && d.lastDeltaMilli != 0
        && d.lastMovementId is string && d.lastMovementId.size() > 0 && d.lastMovementId.size() <= 80
        && d.updatedBy == request.auth.uid && d.updatedAt == request.time
        && d.createdAt is timestamp;
    }
    function stockMovementValid(companyId, stockId, previous) {
      let d = request.resource.data;
      let path = /databases/$(database)/documents/companies/$(companyId)/stock_movements/$(d.lastMovementId);
      return existsAfter(path)
        && getAfter(path).data.stockId == stockId
        && getAfter(path).data.beforeMilli == previous
        && getAfter(path).data.afterMilli == d.quantityMilli
        && getAfter(path).data.deltaMilli == d.lastDeltaMilli
        && getAfter(path).data.createdBy == request.auth.uid
        && (
          (getAfter(path).data.kind == 'purchase_in' && canCompanyBuy(companyId))
          || (getAfter(path).data.kind == 'enfesto_out' && canCompanyConsume(companyId))
        );
    }
    function validMovement(companyId, movementId) {
      let d = request.resource.data;
      let balancePath = /databases/$(database)/documents/companies/$(companyId)/inventory/$(d.stockId);
      return d.keys().hasOnly(['stockId','kind','sourceId','oc','beforeMilli','deltaMilli','afterMilli','material','color','unit','createdAt','createdBy'])
        && d.keys().hasAll(['stockId','kind','sourceId','oc','beforeMilli','deltaMilli','afterMilli','material','color','unit','createdAt','createdBy'])
        && d.stockId is string && d.stockId.size() > 0 && d.stockId.size() <= 80
        && d.sourceId is string && d.sourceId.size() > 0 && d.sourceId.size() <= 100
        && d.kind in ['purchase_in','enfesto_out']
        && d.oc is string && d.oc.size() <= 80
        && d.material is string && d.material.size() <= 250
        && d.color is string && d.color.size() <= 100
        && d.unit in ['KG','M','UN','PC','CX','L','OUT']
        && d.beforeMilli is int && d.beforeMilli >= 0
        && d.deltaMilli is int && d.deltaMilli != 0
        && d.afterMilli is int && d.afterMilli >= 0 && d.afterMilli == d.beforeMilli + d.deltaMilli
        && d.createdAt == request.time && d.createdBy == request.auth.uid
        && existsAfter(balancePath)
        && getAfter(balancePath).data.lastMovementId == movementId
        && getAfter(balancePath).data.quantityMilli == d.afterMilli
        && (
          (d.kind == 'purchase_in'
            && d.deltaMilli > 0 && canCompanyBuy(companyId)
            && existsAfter(/databases/$(database)/documents/companies/$(companyId)/purchases/$(d.sourceId))
            && getAfter(/databases/$(database)/documents/companies/$(companyId)/purchases/$(d.sourceId)).data.status == 'confirmed')
          || (d.kind == 'enfesto_out'
            && d.deltaMilli < 0 && canCompanyConsume(companyId)
            && existsAfter(/databases/$(database)/documents/companies/$(companyId)/enfesto_confirmations/$(d.sourceId))
            && getAfter(/databases/$(database)/documents/companies/$(companyId)/enfesto_confirmations/$(d.sourceId)).data.status == 'confirmed')
        );
    }

    match /companies/{companyId} {
      allow read, write: if false;

      match /purchases/{purchaseId} {
        allow get, list: if canCompanyView(companyId);
        allow create: if canCompanyBuy(companyId)
          && request.resource.data.keys().hasOnly(['accessKey','xmlHash','supplier','supplierTaxId','number','date','totalCents','source','status','lines','pdfData','pdfName','createdAt','createdBy'])
          && request.resource.data.supplier is string && request.resource.data.supplier.size() > 0 && request.resource.data.supplier.size() <= 250
          && request.resource.data.supplierTaxId is string && request.resource.data.supplierTaxId.size() <= 40
          && request.resource.data.number is string && request.resource.data.number.size() <= 80
          && request.resource.data.date is string && request.resource.data.date.size() <= 30
          && request.resource.data.accessKey is string && request.resource.data.accessKey.size() <= 44
          && request.resource.data.xmlHash is string && request.resource.data.xmlHash.size() <= 100
          && request.resource.data.totalCents is int && request.resource.data.totalCents >= 0
          && request.resource.data.source in ['xml','pdf','manual']
          && request.resource.data.status == 'confirmed'
          && request.resource.data.lines is list && request.resource.data.lines.size() >= 1 && request.resource.data.lines.size() <= 25
          && request.resource.data.get('pdfData','') is string && request.resource.data.get('pdfData','').size() <= 560000
          && request.resource.data.get('pdfName','') is string && request.resource.data.get('pdfName','').size() <= 200
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /inventory/{stockId} {
        allow get, list: if canCompanyView(companyId) || canCompanyConsume(companyId);
        allow create: if canCompanyConsume(companyId)
          && validStock(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.quantityMilli == request.resource.data.lastDeltaMilli
          && stockMovementValid(companyId, stockId, 0);
        allow update: if canCompanyConsume(companyId)
          && validStock(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.material == resource.data.material
          && request.resource.data.color == resource.data.color
          && request.resource.data.unit == resource.data.unit
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.quantityMilli == resource.data.quantityMilli + request.resource.data.lastDeltaMilli
          && stockMovementValid(companyId, stockId, resource.data.quantityMilli);
        allow delete: if false;
      }

      match /stock_movements/{movementId} {
        allow get, list: if canCompanyView(companyId);
        allow create: if canCompanyConsume(companyId) && validMovement(companyId, movementId);
        allow update, delete: if false;
      }

      match /enfesto_confirmations/{confirmationId} {
        allow get, list: if canCompanyView(companyId) || canCompanyConsume(companyId);
        allow create: if canCompanyConsume(companyId)
          && request.resource.data.keys().hasOnly(['oc','notes','status','lines','sheetId','createdAt','createdBy'])
          && request.resource.data.oc is string && request.resource.data.oc.size() > 0 && request.resource.data.oc.size() <= 80
          && request.resource.data.notes is string && request.resource.data.notes.size() <= 500
          && request.resource.data.lines is list && request.resource.data.lines.size() >= 1 && request.resource.data.lines.size() <= 20
          && request.resource.data.status == 'confirmed'
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
          && (!('sheetId' in request.resource.data) || (
            canWrite('enfesto')
            && request.resource.data.sheetId == confirmationId
            && get(/databases/$(database)/documents/production_sheets/$(confirmationId)).data.status in ['enfesto','pending']
            && get(/databases/$(database)/documents/production_sheets/$(confirmationId)).data.get('enfestoConfirmationId', '') == ''
            && getAfter(/databases/$(database)/documents/production_sheets/$(confirmationId)).data.status == 'pending'
            && getAfter(/databases/$(database)/documents/production_sheets/$(confirmationId)).data.enfestoConfirmationId == confirmationId
            && getAfter(/databases/$(database)/documents/production_sheets/$(confirmationId)).data.enfestoCompletedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/production_sheets/$(confirmationId)).data.oc == request.resource.data.oc
          ));
        allow update, delete: if false;
      }

      match /bills/{billId} {
        allow get, list: if canCompanyView(companyId);
        allow create: if canCompanyBuy(companyId)
          && request.resource.data.keys().hasOnly(['supplier','amountCents','dueDate','barcode','purchaseId','status','pdfName','pdfData','createdAt','createdBy'])
          && request.resource.data.supplier is string && request.resource.data.supplier.size() > 0 && request.resource.data.supplier.size() <= 250
          && request.resource.data.amountCents is int && request.resource.data.amountCents > 0
          && request.resource.data.dueDate is string && request.resource.data.dueDate.size() == 10
          && request.resource.data.barcode is string && request.resource.data.barcode.size() <= 100
          && request.resource.data.purchaseId is string && request.resource.data.purchaseId.size() <= 100
          && request.resource.data.pdfData is string && request.resource.data.pdfData.size() < 560000
          && request.resource.data.pdfData.matches('data:application/pdf;base64,.*')
          && request.resource.data.pdfName is string && request.resource.data.pdfName.size() <= 200
          && request.resource.data.status == 'pending'
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
